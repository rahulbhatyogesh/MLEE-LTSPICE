# A virtualenv has absolute paths to this machine baked into its scripts, so it
# cannot work anywhere else. 1.4 GB of noise; recreate with:
#   py -3.12 -m venv .venv && .venv/Scripts/python -m pip install -e ".[detect,report,data]"
.venv/
__pycache__/
*.pyc

# 442 MB: over GitHub's 100 MB per-file hard limit, and redundant -- its
# contents are already extracted into runs/.
mlee_cghd-*.zip

# A second venv, CUDA-enabled, used only to train the small diode-orientation
# model on the laptop GPU. The main .venv stays CPU-only on purpose (gotcha:
# rebuilding it around CUDA puts YOLO and the TorchScript U-Net at risk).
.venv-gpu/

# CGHD is fetched, not committed: scripts/fetch_subset.py pulls any drafter
# from the HuggingFace dataset on demand, and the full set is 4.8 GB. Drafters
# 1 and 2 were committed before this rule and stay tracked -- .gitignore does
# not apply to files already in the index -- so this only stops the other 31
# from being swept up by `git add -A`.
data/cghd/drafter_*/

# 25 MB of diode crops, regenerated by `python scripts/diode_orient.py --build`.
data/diode_orient.npz
data/diode_orient.npz.*

# ---------------------------------------------------------------------------
# Regenerable run artifacts. Each is reproducible from a command in CLAUDE.md,
# and together they are ~1.1 GB -- the repo is for the code, the weights and
# the measured numbers (outputs/*.json), not for every intermediate it wrote.

# 836 MB. A YOLO-format copy of the held-out drafters, built from data/cghd by
#   python -m circuit2spice.voc2yolo   (then scripts/eval_heldout.py)
data/yolo_heldout/

# 139 MB of per-image .asc/.cir/.net/overlays from scripts/eval_roundtrip.py.
# The verdict itself is outputs/roundtrip.json, which IS committed.
outputs/roundtrip/

# 86 MB of human-checkable packs: python scripts/inspect_circuit.py --circuits ...
outputs/inspect/

# GUI session artifacts, written by whichever photo was dropped on the window.
outputs/gui/

# Per-image pipeline output from a demo run. outputs/demo/ and outputs/demo_yolo/
# predate this rule and stay tracked as worked examples; the rest are not
# evidence of anything outputs/*.json does not already carry.
outputs/demo_[a-z]*/

# YOLO validation runs. runs/yolov8s-2/ is the training run the weights came
# from and stays tracked; these are re-derivable with scripts/eval_heldout.py.
runs/detect/

# A staged copy of the whole project for course submission -- 129 MB of files
# that are all already in the repo at their real paths.
folderupload/
To-Upload/
